---
import StaticTocList from './StaticTocList.astro';

const { toc } = Astro.locals.starlightRoute;
---

{
  toc && (
    <>
      <div class="lg:sl-hidden">
        <nav class="mobile-static-toc" aria-labelledby="starlight__on-this-page--mobile">
          <details id="starlight__mobile-toc">
            <summary id="starlight__on-this-page--mobile">
              <span>On this page</span>
              <span class="caret" aria-hidden="true">&rsaquo;</span>
            </summary>
            <div class="dropdown">
              <StaticTocList toc={toc.items} isMobile />
            </div>
          </details>
        </nav>
      </div>
      <div class="right-sidebar-panel sl-hidden lg:sl-block">
        <div class="sl-container">
          <nav aria-labelledby="starlight__on-this-page">
            <h2 id="starlight__on-this-page">On this page</h2>
            <StaticTocList toc={toc.items} />
          </nav>
        </div>
      </div>
    </>
  )
}

<style>
  @layer starlight.core {
    .right-sidebar-panel {
      padding: 1rem var(--sl-sidebar-pad-x);
    }

    .sl-container {
      width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    }

    .right-sidebar-panel :global(h2) {
      margin-bottom: 0.5rem;
      color: var(--sl-color-white);
      font-size: var(--sl-text-h5);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
    }

    .right-sidebar-panel :global(:where(a)) {
      display: block;
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
      text-decoration: none;
      overflow-wrap: anywhere;
    }

    .right-sidebar-panel :global(:where(a):hover) {
      color: var(--sl-color-white);
    }

    .mobile-static-toc {
      position: fixed;
      z-index: var(--sl-z-index-toc);
      inset-inline: 0;
      top: calc(var(--sl-nav-height) - 1px);
      border-top: 1px solid var(--sl-color-gray-5);
      background-color: var(--sl-color-bg-nav);
    }

    @media (min-width: 50rem) {
      .mobile-static-toc {
        inset-inline-start: var(--sl-content-inline-start, 0);
      }
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: var(--sl-mobile-toc-height);
      padding: 0.5rem 1rem;
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      color: var(--sl-color-white);
      font-size: var(--sl-text-xs);
      cursor: pointer;
      user-select: none;
      outline-offset: var(--sl-outline-offset-inside);
    }

    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }

    .caret {
      font-size: 1rem;
      transition: transform 0.15s ease;
    }

    details[open] .caret {
      transform: rotate(90deg);
    }

    .dropdown {
      max-height: calc(85vh - var(--sl-nav-height) - var(--sl-mobile-toc-height));
      border: 1px solid var(--sl-color-gray-6);
      border-top-color: var(--sl-color-hairline-shade);
      background-color: var(--sl-color-black);
      box-shadow: var(--sl-shadow-md);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    @media (min-width: 72rem) {
      .sl-container {
        max-width: calc(
          (100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 * var(--sl-sidebar-pad-x)) * 0.25
        );
      }
    }
  }
</style>
